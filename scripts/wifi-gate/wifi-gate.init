#!/bin/sh /etc/rc.common
# wifi-gate：Tailscale 出口节点可用才开放主 Wi-Fi；等待期间蓝灯闪。
# 停用本服务（stop 或 disable）会把 Wi-Fi 重新打开并恢复固件默认灯光。
START=82
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/sbin/wifi-gate.sh run
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/wifi-gate.sh force-on >/dev/null 2>&1
	rm -f /var/run/wifi-gate.state
	logger -t wifi-gate "服务已停止：Wi-Fi 已恢复开启，灯光恢复默认"
}

# 系统重启时不要执行 stop（否则会把 Wi-Fi 持久写成开启，抵消 S19 的前置关闭）。
shutdown() { :; }
